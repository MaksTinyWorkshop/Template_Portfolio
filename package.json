{
  "name": "portfolio-max",
  "version": "1.0.0",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "psql $DATABASE_URL -f prisma/seed.sql",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbo",
    "dev:clean": "rm -rf .next && NEXT_TELEMETRY_DISABLED=1 next dev --turbo",
    "dev:fast": "NEXT_TELEMETRY_DISABLED=1 next dev --turbo --experimental-https",
    "dev:local": "NODE_ENV=development DATABASE_URL=postgresql://Max:max@localhost:5432/portfolio NEXT_TELEMETRY_DISABLED=1 next dev --turbo",
    "export": "next export",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "biome-write": "npx @biomejs/biome format --write .",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.0",
    "@next/mdx": "^16.0.10",
    "@octokit/rest": "^22.0.1",
    "@once-ui-system/core": "^1.5.6",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@uiw/react-md-editor": "^4.0.11",
    "@vitest/coverage-v8": "^4.0.18",
    "classnames": "^2.5.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "lint-staged": "^16.1.5",
    "next": "^16.0.10",
    "next-mdx-remote": "^5.0.0",
    "pg": "^8.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "sass": "^1.86.3",
    "simple-git": "^3.30.0",
    "transliteration": "^2.3.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@faker-js/faker": "^8.1.0",
    "@playwright/test": "^1.58.1",
    "@seontechnologies/playwright-utils": "^3.13.1",
    "@types/cookie": "^0.6.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.17.30",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.5",
    "eslint": "^9.25.0",
    "jsdom": "^28.0.0",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "tzdata": "^1.0.44",
    "vite-tsconfig-paths": "^4.0.4",
    "vitest": "^4.0.18"
  }
}
